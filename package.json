{
  "name": "keyweaver",
  "version": "1.0.4",
  "description": "Fast, zero-dependency generator of stable string keys from nested data structures — object key order doesn't matter. Ideal for cache keys, memoization and deduplication.",
  "author": "Andrii Dubetskyi",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Krombik/keyweaver.git"
  },
  "bugs": {
    "url": "https://github.com/Krombik/keyweaver/issues"
  },
  "homepage": "https://github.com/Krombik/keyweaver#readme",
  "type": "module",
  "source": "src/index.ts",
  "engines": {
    "node": ">=14"
  },
  "scripts": {
    "build": "tsdown",
    "watch": "tsdown --watch",
    "test": "tsdown && node --test",
    "lint": "eslint src test tsdown.config.ts",
    "release": "npm test && npm publish ./build"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.5.5",
    "eslint": "^10.7.0",
    "prettier": "3.9.5",
    "tsdown": "0.22.9",
    "typescript": "7.0.2",
    "typescript-eslint": "^8.64.0",
    "unrun": "^0.3.1"
  },
  "keywords": [
    "cache-key",
    "key-generator",
    "stable-key",
    "serialize",
    "stringify",
    "memoization",
    "deduplication",
    "query-key",
    "nested",
    "object",
    "unique",
    "typescript"
  ],
  "sideEffects": false
}
